@echo off
:: ============================================================================
:: OmniType v2.1 — نصب خودکار محیط (یکبار برای همیشه)
:: ساخت venv + نصب همه وابستگی‌ها از requirements.txt در یک قدم
:: اجرا:  دوبار کلیک روی این فایل  یا  install_deps.bat
:: ============================================================================
setlocal
cd /d "%~dp0"

title OmniType v2.1 — نصب خودکار

echo.
echo ============================================================
echo   OmniType v2.1 — نصب خودکار محیط مجازی و وابستگی‌ها
echo ============================================================
echo.

:: ------------------------------------------------------------------
:: گام ۱: بررسی وجود پایتون
:: ------------------------------------------------------------------
where python >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Python پیدا نشد. از https://www.python.org/downloads نصب کنید
    echo         و حتماً تیک "Add Python to PATH" را بزنید.
    echo.
    pause
    exit /b 1
)

for /f "tokens=*" %%v in ('python --version 2^>^&1') do set PY_VER=%%v
echo [1/4] پایتون پیدا شد: %PY_VER%

:: ------------------------------------------------------------------
:: گام ۲: ساخت محیط مجازی (اگر از قبل نباشد)
:: ------------------------------------------------------------------
if exist "voice_env\Scripts\python.exe" (
    echo [2/4] محیط مجازی voice_env از قبل وجود دارد — رد می‌شود.
) else (
    echo [2/4] ساخت محیط مجازی voice_env ...
    python -m venv voice_env
    if errorlevel 1 (
        echo [ERROR] ساخت محیط مجازی ناموفق بود.
        pause
        exit /b 1
    )
)

:: ------------------------------------------------------------------
:: گام ۳: ارتقای pip
:: ------------------------------------------------------------------
echo [3/4] به‌روزرسانی pip ...
"voice_env\Scripts\python.exe" -m pip install --upgrade pip
if errorlevel 1 (
    echo [WARN] ارتقای pip ناموفق بود — ادامه می‌دهیم.
)

:: ------------------------------------------------------------------
:: گام ۴: نصب وابستگی‌ها
:: ------------------------------------------------------------------
echo [4/4] نصب وابستگی‌ها از requirements.txt ...
"voice_env\Scripts\python.exe" -m pip install -r requirements.txt
if errorlevel 1 (
    echo.
    echo [ERROR] نصب وابستگی‌ها با خطا مواجه شد.
    echo         لطفاً خروجی بالا را بررسی کنید.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   ✅ نصب کامل شد!
echo ============================================================
echo.
echo   برای اجرای تستی برنامه، فایل  run.bat  را اجرا کنید.
echo.
pause
endlocal

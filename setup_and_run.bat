@echo off
:: ============================================================================
:: OmniType v2.1 — راه‌اندازی و اجرای یکجا (مخصوص کاربر تازه‌کار)
::
:: این فایل هم نصب را انجام می‌دهد (محیط مجازی + وابستگی‌ها) و هم برنامه را
:: اجرا می‌کند. کافیست دوبار کلیک کنید؛ بقیه‌اش خودکار است.
:: اجرا:  setup_and_run.bat
:: ============================================================================
setlocal
cd /d "%~dp0"

title OmniType v2.1 — نصب و اجرا

echo.
echo ============================================================
echo    OmniType v2.1 — نصب و اجرای خودکار
echo ============================================================
echo.

:: ------------------------------------------------------------------
:: گام ۱: بررسی وجود پایتون
:: ------------------------------------------------------------------
where python >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Python پیدا نشد!
    echo   1. از https://www.python.org/downloads نصب کنید
    echo   2. هنگام نصب حتماً تیک "Add Python to PATH" را بزنید
    echo   3. این فایل را دوباره اجرا کنید
    echo.
    pause
    exit /b 1
)
for /f "tokens=*" %%v in ('python --version 2^>^&1') do set PY_VER=%%v
echo [1/5] پایتون پیدا شد: %PY_VER%

:: ------------------------------------------------------------------
:: گام ۲: ساخت محیط مجازی (اگر از قبل نباشد)
:: ------------------------------------------------------------------
if exist "voice_env\Scripts\python.exe" (
    echo [2/5] محیط مجازی از قبل وجود دارد — رد می‌شود.
) else (
    echo [2/5] ساخت محیط مجازی voice_env ...
    python -m venv voice_env
    if errorlevel 1 (
        echo [ERROR] ساخت محیط مجازی ناموفق بود.
        pause
        exit /b 1
    )
)

:: ------------------------------------------------------------------
:: گام ۳: ارتقای pip
:: ------------------------------------------------------------------
echo [3/5] به‌روزرسانی pip ...
"voice_env\Scripts\python.exe" -m pip install --upgrade pip >nul 2>&1

:: ------------------------------------------------------------------
:: گام ۴: نصب وابستگی‌ها
:: ------------------------------------------------------------------
echo [4/5] نصب وابستگی‌ها ...
"voice_env\Scripts\python.exe" -m pip install -r requirements.txt
if errorlevel 1 (
    echo.
    echo [ERROR] نصب وابستگی‌ها با خطا مواجه شد.
    echo         خروجی بالا را بررسی کنید و دوباره تلاش کنید.
    pause
    exit /b 1
)

:: ------------------------------------------------------------------
:: گام ۵: اجرای برنامه
:: ------------------------------------------------------------------
echo.
echo [5/5] همه‌چیز آماده است — اجرای برنامه ...
echo (برای بستن کنسول و خروج، پنجره را ببندید)
echo.
"voice_env\Scripts\python.exe" OmniType-FreePTT.py

echo.
echo برنامه بسته شد.
pause
endlocal
